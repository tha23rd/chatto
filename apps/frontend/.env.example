# Build-time frontend flags. Copy to `.env` for local `vite dev`, or set as
# environment variables when building the frontend (values are baked into the
# built bundle; they are not runtime-configurable per deployment).

# Fork feature flag: expose the experimental microphone noise suppression
# preference (browser voiceIsolation constraint and the DeepFilterNet3
# LiveKit processor). Anything other than the exact string "true" leaves the
# feature hidden and inert. See .context/voice-noise-suppression-review.md.
VITE_ENABLE_NOISE_SUPPRESSION=false

# Same-origin path for the DeepFilterNet3 WASM/model assets (~24 MB,
# lazy-loaded). This must be exactly `/models/deepfilternet3` — the only
# accepted value; anything else is refused at both build and runtime so
# clients never load models from an unexpected origin. `pnpm build` fetches
# the checksum-pinned files (not committed to git) to the matching static/
# path when the feature flag is on, and FAILS if the flag is on without it.
VITE_NOISE_SUPPRESSION_ASSETS_URL=/models/deepfilternet3
