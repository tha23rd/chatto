{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal native capabilities for the shared Chatto frontend",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*:*" },
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" },
        { "url": "http://[::1]:*" }
      ]
    },
    "websocket:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" }
      ]
    }
  ]
}
